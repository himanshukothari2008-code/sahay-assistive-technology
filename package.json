{
  "name": "accessiaid",
  "version": "1.0.0",
  "description": "Sahay: WCAG 2.2 AA Compliant Assistive Technology & Educational Hub",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix server",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"vite\"",
    "seed": "npm run seed --prefix server",
    "test": "npm run test --prefix server",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "i18next": "^24.2.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
